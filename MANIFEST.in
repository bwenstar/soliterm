# Ship the whole test suite in the sdist, not just the test_*.py files
# setuptools picks up by default: conftest.py is what points every test at
# a throwaway home, so the tests must never travel without it.
include CHANGELOG.md
recursive-include tests *.py
include tools/build_pyz.py tools/keybindings.py tools/screenshots.py
# tests/test_keybindings_doc.py checks the key page against the code
include docs/keybindings.md
# the manual page, which tests/test_man_page.py checks against the code
include man/soliterm.6
# SECURITY.md, which tests/test_cli.py checks against --reset-stats
include SECURITY.md
